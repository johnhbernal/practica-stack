# Copy to .env before: docker compose up --build
# JWT secrets MUST be at least 32 characters and identical across auth + practica.

APP_JWT_SECRET_MASTER=stack-demo-master-secret-min-32-chars!!
APP_JWT_SECRET_SESSION=stack-demo-session-secret-min-32-chars!
POSTGRES_PASSWORD=stackpass

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Baked into the Vite image at build time (browser-reachable URLs)
VITE_AUTH_API_URL=http://localhost:8081
VITE_PRACTICA_API_URL=http://localhost:8082/api
